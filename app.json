{
  "expo": {
    "name": "Lineo",
    "slug": "lineo",
    "version": "0.7.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "lineo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "bundleIdentifier": "com.tomboullay.lineo",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Lineo filme le court point par point pour revoir un point contesté. La vidéo reste sur ce téléphone et est supprimée en fin de match.",
        "NSLocalNetworkUsageDescription": "Lineo relie les téléphones de la session par le Wi-Fi quand le Bluetooth faiblit, pour partager le score. Aucune vidéo n'est envoyée.",
        "NSBonjourServices": ["_lineo._tcp"]
      }
    },
    "android": {
      "package": "com.tomboullay.lineo",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "react-native-video",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/outfit/100Thin/Outfit_100Thin.ttf",
              "node_modules/@expo-google-fonts/outfit/300Light/Outfit_300Light.ttf",
              "node_modules/@expo-google-fonts/outfit/400Regular/Outfit_400Regular.ttf",
              "node_modules/@expo-google-fonts/outfit/500Medium/Outfit_500Medium.ttf",
              "node_modules/@expo-google-fonts/outfit/600SemiBold/Outfit_600SemiBold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Outfit-Thin",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/outfit/100Thin/Outfit_100Thin.ttf",
                    "weight": 100
                  }
                ]
              },
              {
                "fontFamily": "Outfit-Light",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/outfit/300Light/Outfit_300Light.ttf",
                    "weight": 300
                  }
                ]
              },
              {
                "fontFamily": "Outfit-Regular",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/outfit/400Regular/Outfit_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Outfit-Medium",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/outfit/500Medium/Outfit_500Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "Outfit-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/outfit/600SemiBold/Outfit_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "munim-bluetooth",
        {
          "bluetoothBackground": false,
          "androidBluetoothPermissions": ["scan", "connect", "advertise"],
          "bluetoothAlwaysUsageDescription": "Lineo relie les téléphones de la session en Bluetooth pour partager le score. Aucune vidéo n'est envoyée.",
          "multipeerServiceTypes": false
        }
      ],
      [
        "react-native-vosk",
        {
          "models": ["models/vosk-model-small-fr-0.22"],
          "iOSMicrophonePermission": "Lineo enregistre le son avec la vidéo pour revoir un point contesté, et écoute l'annonce du score pour le mettre à jour. Le son reste sur ce téléphone et est supprimé en fin de match."
        }
      ],
      "expo-screen-orientation",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Vosk calls its native library through JNA, by reflection: R8 must keep it.\n# JNA's desktop-only window helpers reference java.awt, absent on Android.\n-dontwarn java.awt.**\n-keep class com.sun.jna.** { *; }\n-keepclassmembers class * extends com.sun.jna.** { public *; }\n-keep class org.vosk.** { *; }\n"
          }
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
