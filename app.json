{
  "expo": {
    "name": "Témoin",
    "slug": "temoin",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "temoin",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111111",
    "ios": {
      "bundleIdentifier": "com.tomboullay.temoin",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Témoin filme le court point par point pour revoir un point contesté. La vidéo reste sur ce téléphone et est supprimée en fin de match."
      }
    },
    "android": {
      "package": "com.tomboullay.temoin",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-video",
      "expo-font",
      [
        "munim-bluetooth",
        {
          "bluetoothBackground": false,
          "androidBluetoothPermissions": ["scan", "connect", "advertise"],
          "bluetoothAlwaysUsageDescription": "Témoin relie les téléphones de la session en Bluetooth pour partager le score. Aucune vidéo n'est envoyée.",
          "multipeerServiceTypes": false
        }
      ],
      [
        "react-native-vosk",
        {
          "models": ["assets/model-fr-fr"],
          "iOSMicrophonePermission": "Témoin écoute l'annonce du score pour le mettre à jour sans toucher au téléphone. Rien n'est enregistré ni envoyé."
        }
      ],
      "expo-screen-orientation"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
