%%{init: {'theme':'base','themeVariables':{'fontFamily':'Helvetica, Arial','fontSize':'15px','primaryColor':'#FFFFFF','primaryTextColor':'#111111','primaryBorderColor':'#3E7A57','lineColor':'#111111','clusterBkg':'#F4F7F5','clusterBorder':'#3E7A57'}}}%%
flowchart LR
  subgraph A["📱 Téléphone HÔTE · crée la session · suffit seul pour jouer"]
    direction TB
    A_UI["<b>Interface</b><br/>Accueil · Créer · Connexion · Score · Replay · Fin"]
    A_F["<b>Fonctionnalités</b><br/>Session · Enregistrement · Replay · Voix · Liaison · Analyse"]
    subgraph A_CORE["Cœur métier · TypeScript pur, testé sans téléphone"]
      direction LR
      A_S["Score<br/>machine à états"]
      A_J["Journal<br/>d'événements<br/><i>référence</i><br/>arbitre les annonces<br/>vocales en double"]
      A_C["File des clips<br/>point en cours<br/>+ précédent"]
      A_V["Vision<br/>court, balle,<br/>rebond, confiance"]
    end
    subgraph A_NAT["Briques natives · bibliothèques"]
      direction LR
      A_CAM["Caméra<br/>VisionCamera"]
      A_MIC["Voix<br/>Vosk FR"]
      A_CV["Pixels<br/>OpenCV"]
      A_LINK["Liaison<br/>local · BLE · Wi-Fi"]
    end
    A_DISK[("Stockage local<br/>clips .mp4<br/>supprimés en fin de match")]
    A_UI --> A_F --> A_CORE
    A_F --> A_NAT
    A_CAM --> A_DISK
  end

  subgraph B["📱 0 à N téléphones INVITÉS · autres points de vue (facultatifs)"]
    direction TB
    B_UI["<b>Interface</b><br/>même écrans"]
    B_F["<b>Fonctionnalités</b><br/>mêmes modules"]
    B_CORE["Cœur métier<br/>copie du journal<br/>envoie ses annonces reconnues à l'hôte"]
    B_NAT["Caméra · Voix · OpenCV · Liaison"]
    B_DISK[("Stockage local<br/>ses propres clips")]
    B_UI --> B_F --> B_CORE
    B_F --> B_NAT --> B_DISK
  end

  A_LINK <== "① Bluetooth BLE · prioritaire<br/>score, annonces vocales reconnues,<br/>validations, VAR, heartbeat" ==> B_NAT
  A_LINK <-. "② Wi-Fi local · secours automatique<br/>si heartbeat perdu ou instable<br/>(+ extrait vidéo d'un autre angle, après V0)" .-> B_NAT

  NOTE["<b>1 téléphone</b> = hôte sans invité, même code.<br/><b>N téléphones</b> = étoile autour de l'hôte,<br/>qui numérote et diffuse les événements.<br/>🔒 Pas de vidéo dans le protocole, aucun serveur."]
  B ~~~ NOTE

  classDef core fill:#E8F1EC,stroke:#3E7A57,stroke-width:2px,color:#111111
  classDef nat fill:#FFF6E3,stroke:#E9B44C,stroke-width:2px,color:#111111
  classDef ui fill:#111111,stroke:#111111,color:#FFFFFF
  classDef note fill:#FFFFFF,stroke:#111111,stroke-dasharray:4 3,color:#111111
  class A_S,A_J,A_C,A_V,B_CORE core
  class A_CAM,A_MIC,A_CV,A_LINK,B_NAT nat
  class A_UI,B_UI ui
  class NOTE note
